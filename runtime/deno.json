{
  "tasks": {
    "dev": "deno run --unstable-worker-options --allow-env --allow-net --allow-read --allow-write --watch main.ts",
    "generate:api": "deno run --allow-env --allow-read --allow-write generate-api.ts",
    "start": "deno run --unstable-worker-options --allow-env --allow-net --allow-read --allow-write main.ts",
    "extensions": "deno run --unstable-worker-options --allow-env --allow-net --allow-read --allow-write extension-cli.ts",
    "check": "deno check *.ts",
    "lint": "deno lint",
    "test": "deno test --unstable-worker-options --allow-env --allow-net --allow-read --allow-write *.spec.ts"
  },
  "imports": {
    "ajv": "npm:ajv@8.20.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/path": "jsr:@std/path@1.1.6",
    "@std/yaml": "jsr:@std/yaml@1.1.2"
  }
}
