{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Edge Connector Desktop",
  "version": "0.1.0",
  "identifier": "de.flamox.edge-connector.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Edge Connector Desktop",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../resources/connector/": "connector/"
    }
  }
}
