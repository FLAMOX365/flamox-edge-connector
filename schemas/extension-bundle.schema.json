{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flamox.com/edge-connector/extension-bundle.schema.json",
  "title": "Edge Connector Extension Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mediaType", "release", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mediaType": { "const": "application/vnd.flamox.edge-extension+json" },
    "release": { "$ref": "extension-release.schema.json" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "contentBase64"],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
          },
          "contentBase64": { "type": "string", "contentEncoding": "base64" }
        }
      }
    }
  }
}
