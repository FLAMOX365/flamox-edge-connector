{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.flamox.com/edge-connector/extension-release.schema.json",
  "title": "Edge extension release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extensionId",
    "version",
    "digest",
    "publisher",
    "publisherKeyId",
    "signature"
  ],
  "properties": {
    "extensionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "version": { "type": "string" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "publisher": { "type": "string", "minLength": 1 },
    "publisherKeyId": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "contentEncoding": "base64" }
  }
}
