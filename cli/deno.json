{
  "name": "@edge/extension-cli",
  "version": "0.1.0",
  "exports": "./main.ts",
  "imports": {
    "ajv": "npm:ajv@8.20.0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/path": "jsr:@std/path@1"
  },
  "tasks": {
    "start": "deno run --unstable-worker-options --allow-env --allow-net --allow-read --allow-write --allow-run=deno,osascript,powershell.exe,pwsh,zenity,kdialog main.ts",
    "compile": "deno compile --unstable-worker-options --allow-env --allow-net --allow-read --allow-write --allow-run=deno,osascript,powershell.exe,pwsh,zenity,kdialog --include ../runtime/extension-worker.ts --output dist/extension main.ts",
    "check": "deno check *.ts",
    "test": "deno test --unstable-worker-options --allow-env --allow-net --allow-read --allow-write --allow-run=deno *.spec.ts"
  }
}
