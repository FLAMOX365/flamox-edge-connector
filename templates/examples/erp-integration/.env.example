# ERP Integration Configuration
# =============================
# Copy this file to .env and adjust the values.

# Connector endpoint and credentials provided by FLAMOX365
FLAMOX_HOST=https://api.example.com
FLAMOX_CLIENT_ID=your-client-id
FLAMOX_CLIENT_SECRET=your-client-secret
FLAMOX_WS_URL=wss://api.example.com/connector/ws?tenant=your-tenant
FLAMOX_LOG_LEVEL=info

# SAP Gateway URL
ERP_URL=https://sap-gateway.example.com

# SAP service account credentials
ERP_USER=svc_edge_connector
ERP_PASSWORD=your-secret-password

# SAP system ID (optional, default: PRD)
ERP_SYSTEM=PRD
