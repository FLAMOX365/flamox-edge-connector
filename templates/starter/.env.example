EDGE_CONNECTOR_BIND_PORT=8080
EDGE_CONNECTOR_LOG_LEVEL=info
EDGE_CONNECTOR_DISPLAY_NAME=Customer DMZ 1

# Create this one-time code in FLAMOX365. Remove PAIRING_CODE after the first
# successful start while preserving the connector data volume.
EDGE_CONNECTOR_MANAGEMENT_URL=https://api.example.com/api/v1/
EDGE_CONNECTOR_PAIRING_CODE=

